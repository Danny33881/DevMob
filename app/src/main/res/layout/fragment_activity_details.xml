<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/white">


<ImageView
    android:id="@+id/icons_arrow"
    android:layout_width="32dp"
    android:layout_height="32dp"
    android:layout_marginTop="20dp"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    android:src="@drawable/arrow_back" />

<TextView
    android:id="@+id/activity_name"
    android:layout_width="0dp"
    android:layout_height="32dp"
    android:layout_marginStart="30dp"
    android:layout_marginEnd="60dp"
    android:text="Серфинг"
    android:textColor="@color/black"
    android:textSize="24sp"
    android:textStyle="bold"
    app:layout_constraintTop_toTopOf="@id/icons_arrow"
    app:layout_constraintStart_toEndOf="@id/icons_arrow" />

<ImageView
    android:id="@+id/trasher"
    android:layout_width="32dp"
    android:layout_height="32dp"
    android:layout_marginEnd="20dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true"
    app:layout_constraintEnd_toStartOf="@id/info"
    app:layout_constraintTop_toTopOf="@id/icons_arrow"
    app:layout_constraintBottom_toBottomOf="@id/icons_arrow"
    android:src="@drawable/trasher" />

<ImageView
    android:id="@+id/info"
    android:layout_width="32dp"
    android:layout_height="32dp"
    android:layout_marginEnd="20dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toTopOf="@id/icons_arrow"
    app:layout_constraintBottom_toBottomOf="@id/icons_arrow"
    android:src="@drawable/info" />


<TextView
    android:id="@+id/length"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:text="14.32 км"
    android:textColor="@color/black"
    android:textSize="24sp"
    android:textStyle="bold"
    android:layout_marginTop="20dp"
    android:layout_marginStart="20dp"
    app:layout_constraintTop_toBottomOf="@+id/icons_arrow"
    app:layout_constraintStart_toStartOf="parent"/>

<TextView
    android:id="@+id/when_was"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:text="14 часов назад"
    android:textColor="@color/grey"
    android:textSize="16sp"
    android:layout_marginTop="5dp"
    android:layout_marginStart="20dp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/length"/>

<TextView
    android:id="@+id/time"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:text="2 часа 46 минут"
    android:textColor="@color/black"
    android:textSize="24sp"
    android:textStyle="bold"
    android:layout_marginTop="20dp"
    android:layout_marginStart="20dp"
    app:layout_constraintTop_toBottomOf="@+id/when_was"
    app:layout_constraintStart_toStartOf="parent"/>

<TextView
    android:id="@+id/start"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:text="Старт"
    android:textColor="@color/black"
    android:textSize="16sp"
    android:layout_marginTop="5dp"
    android:layout_marginStart="20dp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/time"/>

<TextView
    android:id="@+id/start_time"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:text=" 14:49"
    android:textColor="@color/grey"
    android:textSize="16sp"
    app:layout_constraintStart_toEndOf="@id/start"
    app:layout_constraintTop_toTopOf="@id/start"
    app:layout_constraintBottom_toBottomOf="@id/start"/>

<TextView
    android:id="@+id/devider"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:text="|"
    android:textColor="@color/grey"
    android:textSize="16sp"
    android:layout_marginStart="20dp"
    app:layout_constraintStart_toEndOf="@id/start_time"
    app:layout_constraintTop_toTopOf="@id/start"
    app:layout_constraintBottom_toBottomOf="@id/start"/>

<TextView
    android:id="@+id/end"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:text="Финиш"
    android:textColor="@color/black"
    android:textSize="16sp"
    android:layout_marginStart="20dp"
    app:layout_constraintStart_toEndOf="@id/devider"
    app:layout_constraintTop_toTopOf="@id/start"
    app:layout_constraintTop_toBottomOf="@id/time"/>

<TextView
    android:id="@+id/and_time"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:text=" 16:31"
    android:textColor="@color/grey"
    android:textSize="16sp"
    app:layout_constraintStart_toEndOf="@+id/end"
    app:layout_constraintTop_toTopOf="@+id/start"
    app:layout_constraintBottom_toBottomOf="@id/start"/>



<com.google.android.material.textfield.TextInputLayout
    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
    android:id="@+id/login"
    android:layout_width="0dp"
    android:layout_marginTop="20dp"
    android:layout_marginBottom="10dp"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:textSize="16sp"
    android:layout_height="wrap_content"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/start">
    <com.google.android.material.textfield.TextInputEditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="15dp"
        android:hint="@string/comment" />
</com.google.android.material.textfield.TextInputLayout>



</androidx.constraintlayout.widget.ConstraintLayout>